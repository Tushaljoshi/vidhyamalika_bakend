
<div class="dashboard-main-body">
    <div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
    <div class="">
        <h1 class="fw-semibold mb-4 h6 text-primary-light">All Blogs</h1>
        <div class="">
            <a href="/dashboard" class="text-secondary-light hover-text-primary hover-underline">Dashboard </a>
            <span class="text-secondary-light">/ All Blogs</span>
        </div>
        </div>
            <a href="/blog/create" class="btn btn-primary-600 d-flex align-items-center gap-6 "><span class="d-flex text-md"><i class="ri-add-large-line"></i></span>Add New</a>
        </div>
    <div class="mt-24">
        <div class="card h-100">
            <div class="card-body dataTable-wrapper p-0"> 
                <div class="d-flex flex-wrap justify-content-between gap-16 px-20 py-12 border-bottom border-neutral-200">
                        <form class="navbar-search dt-search m-0">
                            <input type="text" class="dt-input bg-transparent radius-4" aria-controls="dataTable"
                                name="search" placeholder="Search...">
                            <iconify-icon icon="ion:search-outline" class="icon"></iconify-icon>
                        </form>
                        <div class="d-flex align-items-center gap-8 text-secondary-light">
                            <span class="">
                                Rows per page:
                            </span>
                            <div class="dt-length">
                                <select name="dataTable_length" aria-controls="dataTable"
                                    class="dt-input form-control form-select">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                        </div>
                    </div>
                <div class="p-0">
                    <table class="table data-table" id="" data-page-length='10'>       
                        <thead>
                            <tr>
                                <th scope="col">
                                    <div class="form-check style-check d-flex align-items-center">
                                        <!-- <input class="form-check-input" type="checkbox"> -->
                                        <label class="form-check-label">
                                            S.N.
                                        </label>
                                    </div>
                                </th>
                                <th scope="col">Image</th>
                                <th scope="col">Title</th>
                                <th scope="col">Create Date</th> 
                                <th scope="col">Status</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>  
                            <% blogs.forEach((blog, index) => { %>
                            <tr>
                                <td>
                                    <div class="form-check style-check d-flex align-items-center">
                                        <!-- <input class="form-check-input" type="checkbox"> -->
                                        <label class="form-check-label">
                                         <%= index + 1 %>
                                        </label>
                                    </div>
                                </td>
                                <td><img src="<%= blog.thumbnail %>" width="150px"></td>
                              <td>
                                    <span>
                                        <%= blog.title ? (blog.title.length > 30 ? blog.title.substring(0, 30) + '...' : blog.title) : "N/A" %>
                                    </span>
                                    </td>
                                <td>  <%= new Date(blog.created_at).toLocaleDateString('en-IN', {
                                        day: '2-digit',
                                        month: 'short',
                                        year: 'numeric'
                                    }) %></td> 
                                <td> <span class="<%= blog.status ? 'bg-success-100 text-success-600' : 'bg-danger-100 text-danger-600' %> px-24 py-4 radius-4 fw-medium text-sm"><%= blog.status ? 'Active' : 'Inactive' %></span>
                                </td>
                                <td>
                                    <div class="d-flex">
                                         
                                                <a href="/blog/view/<%= blog._id %>"
                                                    title="View"
                                                    class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex justify-content-center gap-2 py-6">
                                                  <i class="ri-eye-line"></i> 
                                                </a>
                                            
                                                <a href="/blog/edit/<%= blog._id %>"
                                                    title="Edit"
                                                    class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex justify-content-center gap-2 py-6">
                                                    <i class="ri-edit-2-line"></i> 
                                                </a>
                                            
                                               <button
                                               title="Delete"
                                                class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex justify-content-center gap-2 py-6 delete_btn"
                                                type="button" data-id="<%= blog._id %>">
                                                <i class="ri-delete-bin-6-line"></i>
                                                </button>
                                            
                                    </div>
                                </td>
                            </tr>
                           <% }) %> 
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%
script = `
<script src="/assets/js/pages/blog.js"></script>
`;
%>