    <div class="dashboard-main-body">

        <div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
  <div class="">
    <h1 class="fw-semibold mb-4 h6 text-primary-light">Edit Teacher</h1>
    <div class="">
      <a href="/dashboard" class="text-secondary-light hover-text-primary hover-underline">Dashboard </a>
      <a href="teachers" class="text-secondary-light hover-text-primary hover-underline "> /
        Teachers</a>
      <span class="text-secondary-light">/ Edit Teacher</span>
    </div>
  </div> 
</div>

        <form action="/teacher/update" method="POST" class="mt-24" enctype="multipart/form-data">
            <input type="hidden" name="teacher_id" value="<%= teacher._id %>">
            <div class="row gy-3">
                <div class="col-lg-12">
                    <div class="shadow-1 radius-12 bg-base h-100 overflow-hidden">
                        <div
                            class="card-header border-bottom bg-base py-16 px-24 d-flex align-items-center justify-content-between">
                            <h6 class="text-lg fw-semibold mb-0">Personal Info</h6>
                        </div>
                        <div class="card-body p-20">
                            <div class="row gy-3"> 
                                <div class="col-xxl-6 col-xl-6 col-sm-6">
                                    <div class="">
                                        <label for="name"
                                            class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Full Name
                                            <span class="text-danger-600">*</span> </label>
                                            <input type="text" name="name" class="form-control" id="name" value="<%= teacher.name %>" placeholder="Enter Teacher Name">
                                    </div>
                                </div>
                                <div class="col-xxl-6 col-xl-6 col-sm-6">
                                    <div class="">
                                        <label for="email" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Email 
                                            <span class="text-danger-600">*</span> 
                                        </label>
                                        <input type="text" name="email" class="form-control" id="email" value="<%= teacher.email %>" placeholder="Enter Teacher Email">
                                    </div>
                                </div>
                                <div class="col-xxl-6 col-xl-6 col-sm-6">
                                    <div class="">
                                       <label for="phone" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Phone 
                                        <span class="text-danger-600">*</span> 
                                       </label>
                                        <input type="number" name="phone" class="form-control" id="phone" value="<%= teacher.phone %>" placeholder="Enter Teacher Phone">
                                    </div>
                                </div>
                                <div class="col-xxl-6 col-xl-6 col-sm-6">
                                    <div class="">
                                        <label for="gender"
                                            class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Gender 
                                        <span class="text-danger-600">*</span> </label>
                                        <select id="gender" name="gender" class="form-control form-select">
                                            <option value="Select section" disabled>Select Gender</option>
                                            <option value="Male" <%= teacher.gender == "Male" ? "selected":"" %>>Male</option>
                                            <option value="Female" <%= teacher.gender == "Female" ? "selected":"" %>>Female</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xxl-6 col-xl-6 col-sm-6">
                                    <div class="">
                                        <label for="wordExperience"
                                            class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Experience(Years)
                                            <span class="text-danger-600">*</span> </label>
                                        <input type="number" name="experience" class="form-control" value="<%= teacher.experience %>" id="wordExperience"
                                            placeholder="Enter experience">
                                    </div>
                                </div> 
                                <div class="col-xxl-6 col-xl-6 col-sm-6">
                                    <div class="">
                                        <label for="wordExperience"
                                            class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Teacher Photo</label>
                                        <input type="file" name="teacher_photo" class="form-control" id="wordExperience" accept=".jpg,.jpeg,.png" 
                                            placeholder="Enter experience">
                                            <br>
                                            <% if(teacher.photo){ %>
                                                  <img src="<%= teacher.photo %>" alt="Teacher Image" class="h-100 object-fit-cover" width="30%">
                                           <% } %>
                                    </div>
                                </div>  
                                <div class="col-12">
                    <div class="d-flex align-items-center justify-content-center gap-3 mt-8"> 
                        <button type="submit" class="btn btn-primary-600 border border-primary-600 text-md px-28 py-12 radius-8">Update</button>
                    </div>
                </div>
                            </div>
                        </div>
                    </div>
                </div> 
            </div>
        </form>
    </div>
<%
script = `
 
`;
%>