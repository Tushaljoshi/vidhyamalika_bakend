
    <div class="dashboard-main-body">

<div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
  <div class="">
    <h1 class="fw-semibold mb-4 h6 text-primary-light">View Page</h1>
    <div class="">
      <a href="/dashboard" class="text-secondary-light hover-text-primary hover-underline">Dashboard </a>
      <a href="/other-page" class="text-secondary-light hover-text-primary hover-underline "> / Other Pages</a>
      <span class="text-secondary-light">/ View Page</span>
    </div>
  </div> 
</div>

        <form class="mt-24" method="POST" action="/other-page/update">
            <input type="hidden" name="page_id" value="<%= other_page._id %>" >
            <div class="row gy-3">
                <div class="col-lg-12">
                    <div class="shadow-1 radius-12 bg-base h-100 overflow-hidden">
                        <div
                            class="card-header border-bottom bg-base py-16 px-24 d-flex align-items-center justify-content-between">
                            <h6 class="text-lg fw-semibold mb-0">Page Detail</h6>
                        </div>
                        <div class="card-body p-20">
                            <div class="row gy-3">
                                <div class="col-xxl-6 col-xl-6 col-sm-6">
                                    <div class="">
                                        <label for="name" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Page Name</label>
                                     <p><%= other_page.name %></p>
                                    </div>
                                </div>    
                                <div class="col-xxl-6 col-xl-6 col-sm-6">
                                    <div class="">
                                        <label for="status" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Status</label><br>
                                        <span class="<%= other_page.status ? 'bg-success-100 text-success-600' : 'bg-danger-100 text-danger-600' %> px-24 py-4 radius-4 fw-medium text-sm"><%= other_page.status ? 'Active' : 'Inactive' %></span>
                                    </div>
                                </div>
                                <div class="col-xxl-12 col-xl-12 col-sm-12">
                                    <div class="">
                                        <label for="content" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Page Content</label>
                                        <p><%- other_page.content %></p>
                                    </div>
                                </div>  
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="shadow-1 radius-12 bg-base h-100 overflow-hidden">
                        <div
                            class="card-header border-bottom bg-base py-16 px-24 d-flex align-items-center justify-content-between">
                            <h6 class="text-lg fw-semibold mb-0">SEO </h6>
                        </div>
                        <div class="card-body p-20"> 
                            <div class="row">
                             <div class="col-md-12">
                                <div class="">
                                        <label for="meta_title" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Meta Title </label>
                                        <p><%= other_page.meta_title %></p>
                                    </div>
                             </div>
                             <div class="col-md-6 mt-3">
                                <div class="">
                                        <label for="meta_keyword" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Meta Keyword </label>
                                        <p><%= other_page.meta_keyword %></p>
                                    </div>
                             </div>
                             <div class="col-md-6 mt-3">
                                <div class="">
                                        <label for="meta_description" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Meta Description </label>
                                       <p><%= other_page.meta_description %></p>
                                    </div>
                             </div>
                             </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="d-flex align-items-center justify-content-center gap-3 mt-8"> 
                        <button type="submit" class="btn btn-primary-600 border border-primary-600 text-md px-28 py-12 radius-8">Submit</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
