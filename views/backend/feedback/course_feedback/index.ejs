
<div class="dashboard-main-body">
    <div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
    <div class="">
        <h1 class="fw-semibold mb-4 h6 text-primary-light">All Feedback</h1>
        <div class="">
            <a href="/dashboard" class="text-secondary-light hover-text-primary hover-underline">Dashboard </a>
            <span class="text-secondary-light">/ All Feedback</span>
        </div>
        </div>
          
        </div>
    <div class="mt-24">
        <div class="card h-100">
            <div class="card-body dataTable-wrapper p-0"> 
                <div class="d-flex flex-wrap align-items-center gap-16 px-20 py-12 border-bottom border-neutral-200">
                        <form class="navbar-search dt-search m-0">
                            <input type="text" class="dt-input bg-transparent radius-4" aria-controls="dataTable"
                                name="search" placeholder="Search...">
                            <iconify-icon icon="ion:search-outline" class="icon"></iconify-icon>
                        </form>
                    </div>
                <div class="p-0">
                    <table class="table data-table" id="" data-page-length='10'>       
                        <thead>
                            <tr>
                                <th scope="col">
                                    <div class="form-check style-check d-flex align-items-center">
                                        <!-- <input class="form-check-input" type="checkbox"> -->
                                        <label class="form-check-label">
                                            S.N.
                                        </label>
                                    </div>
                                </th>
                                <th scope="col">Student</th>
                                <th scope="col">Feedback</th>
                                <th scope="col">Date</th> 
                                 
                            </tr>
                        </thead>
                        <tbody>
                            <% feedbacks.forEach((feedback, index) => { %> 
                            <tr>
                                <td>
                                    <div class="form-check style-check d-flex align-items-center">
                                        <label class="form-check-label">
                                         1
                                        </label>
                                    </div>
                                </td>
                                <td><%= feedback.student_id.name %></td>
                                <td data-bs-toggle="tooltip" title="<%= feedback.feedback %>"><%= feedback.feedback.substring(0, 30) %>... <i class="ri-information-line" title="<%= feedback.feedback %>" style="cursor:pointer;"></i></td>
                                <td><%= 
                                        new Date(feedback.createdAt).toLocaleDateString('en-IN', {
                                            day: '2-digit',
                                            month: 'short',
                                            year: 'numeric'
                                        }) %></td> 
                                 
                            </tr>
                         <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%
script = `
<script src="/assets/js/pages/common_feedback.js"></script>
`;
%>