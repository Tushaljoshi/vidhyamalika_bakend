<div class="dashboard-main-body">

    <!-- Breadcrumb -->
    <div class="breadcrumb d-flex justify-content-between mb-3">
        <div>
            <h6 class="text-primary">Course Test</h6>
            <a href="/dashboard">Dashboard</a> /
            <a href="/course/recorded-course">Recorded Course</a> /
            <span>Course Test</span>
        </div>
    </div> 
        <div class="row"> 
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header"><b>Test Details</b></div>
                    <div class="card-body">
                        <form action="/course/update-test-detail" method="POST">
                            <input type="hidden" name="course_id" value="<%= course_id %>">
                        <div class="row"> 
                            <div class="col-md-6">
                                <label>Test Title</label>
                                <input type="text" name="name" class="form-control"
                                       value="<%= course_test?.name || '' %>" required>
                            </div> 
                            <div class="col-md-2">
                                <label>Duration (Minutes)</label>
                                <input type="number" name="duration" class="form-control"
                                       value="<%= course_test?.duration || '' %>" required>
                            </div> 
                            <div class="col-md-2">
                                <label>Total Que. </label>
                                <input type="number" class="form-control"
                                       value="<%= questions?.length %>" disabled>
                            </div> 
                            <div class="col-md-2" style="padding-top: 27px;">
                               <button class="btn btn-primary" type="submit">Update Test</button>
                            </div> 
                        </div>
                        </form>
                    </div>
                </div>
            </div> 
            <% if(course_test){ %>
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between">
                        <b>Questions</b>

                        <button type="button" class="btn btn-primary btn-sm"
                                data-bs-toggle="modal" data-bs-target="#mcqModal">
                            + Add Question
                        </button>
                    </div> 


                    <div class="card-body" id="questionsContainer">
                        <% if (questions && questions.length > 0) { %>
                            <% questions.forEach((q, index) => { %>
                                <div class="card shadow-sm mb-3 question-block">
                                    <div class="card-body mt-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold mb-0">
                                                Q<%= index + 1 %>. <span class="question-text"><%= q.question %></span>
                                                <input type="hidden" class="test_id" name="test_id" value="<%= q._id %>" >
                                            </h6>
                                            <div>
                                                <button type="button"  class="btn btn-sm btn-secondary me-1 edit-btn"><i class="ri-edit-2-line"></i></button>
                                                <button type="button" class="btn btn-sm btn-danger"><i class="ri-delete-bin-6-line"></i></button>
                                            </div>
                                        </div>
                                        <div class="row mt-3">
                                            <% const options = [q.option_a, q.option_b, q.option_c, q.option_d]; %>
                                            <% options.forEach((opt, i) => { %>
                                                <div class="col-md-6 mb-2">
                                                    <div class="p-10 mb-1 rounded border 
                                                        <%= q.answer == i ? 'bg-success text-white' : 'bg-light' %>">
                                                        <strong><%= String.fromCharCode(65 + i) %>.</strong>
                                                        <span class="option-text"><%= opt %></span>
                                                        <% if (q.answer == i) { %>  
                                                            <span class="badge bg-dark ms-2">Correct</span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                        <div class="d-flex justify-content-between mt-3">
                                            <div>
                                                <span class="badge bg-primary">
                                                    Correct Answer: <span class="correct-answer"><%=  q.answer %></span>
                                                </span>
                                            </div>
                                            <div>
                                                <span class="badge bg-info text-dark">
                                                    Marks: <span class="marks"><%= q.marks %></span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center text-muted py-4">
                                No questions added yet
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>  
            <% } %> 
        </div> 
</div>

<!-- ================= MODAL ================= -->
<div class="modal fade" id="mcqModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content"> 
            <div class="modal-header">
                <h5>Add MCQ Question</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div> 
            <form id="mcqForm" action="/course/add-recorded-course-test-que" method="POST">
                <input type="hidden" name="course_id" value="<%= course_id %>" >
                <input type="hidden" name="course_test_id" value="<%= course_test?._id %>" >
                <div class="modal-body"> 
                    <div class="mb-3">
                        <label>Question</label>
                        <input type="text" name="question" class="form-control" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Option A</label>
                            <input type="text" name="option_a" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Option B</label>
                            <input type="text" name="option_b" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Option C</label>
                            <input type="text" name="option_c" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Option D</label>
                            <input type="text" name="option_d" class="form-control" required>
                        </div>
                    </div> 
                    <div class="row">
                        <div class="col-md-6">
                            <label>Correct Answer</label>
                            <select name="answer" class="form-control" required>
                                <option value="">Select</option>
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label>Marks</label>
                            <input type="number" name="marks" class="form-control" required>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-success">Add Question</button>
                </div>
            </form>

        </div>
    </div>
</div>  


<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content"> 
            <div class="modal-header">
                <h5>Edit Question</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="editForm" action="/course/update-recorded-course-test-que", method="POST">
                 <input type="hidden" name="course_id" value="<%= course_id %>" >
                <div class="modal-body"> 
                    <input type="hidden" id="edit_test_id" name="course_test_id"> 
                    <input type="hidden" id="edit_index"> 
                    <div class="mb-3">
                        <label>Question</label>
                        <input type="text" id="edit_question" name="question" class="form-control">
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                               <label>Option A</label>
                            <input type="text" id="edit_option_a" name="option_a" class="form-control" placeholder="Option A">
                        </div>
                        <div class="col-md-6 mb-2">
                               <label>Option B</label>
                            <input type="text" id="edit_option_b" name="option_b" class="form-control" placeholder="Option B">
                        </div>
                        <div class="col-md-6 mb-2">
                               <label>Option C</label>
                            <input type="text" id="edit_option_c" name="option_c" class="form-control" placeholder="Option C">
                        </div>
                        <div class="col-md-6 mb-2">
                               <label>Option D</label>
                            <input type="text" id="edit_option_d" name="option_d" class="form-control" placeholder="Option D">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                               <label>Correct Answer</label>
                            <select id="edit_answer" name="answer" class="form-control">
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                               <label>Marks</label>
                            <input type="number" id="edit_marks" name="marks" class="form-control" placeholder="Marks">
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Update</button>
                </div>

            </form>

        </div>
    </div>
</div>

<%
script = `
    <script src="/assets/js/pages/recorded_course_test.js"></script>
`;
%>