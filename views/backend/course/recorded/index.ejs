
<div class="dashboard-main-body">
    <div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
    <div class="">
        <h1 class="fw-semibold mb-4 h6 text-primary-light">Recorded Course</h1>
        <div class="">
            <a href="/dashboard" class="text-secondary-light hover-text-primary hover-underline">Dashboard </a>
            <span class="text-secondary-light">/ Recorded Course</span>
        </div>
    </div>
        <a href="/course/recorded-course/create" class="btn btn-primary-600 d-flex align-items-center gap-6 "><span class="d-flex text-md"><i class="ri-add-large-line"></i></span>Add New</a>
    </div>
    <div class="mt-24">
        <div class="card h-100">
            <div class="card-body dataTable-wrapper p-0"> 
                <div class="d-flex flex-wrap justify-content-between gap-16 px-20 py-12 border-bottom border-neutral-200">
                        <form class="navbar-search dt-search m-0">
                            <input type="text" class="dt-input bg-transparent radius-4" aria-controls="dataTable"
                                name="search" placeholder="Search...">
                            <iconify-icon icon="ion:search-outline" class="icon"></iconify-icon>
                        </form>
                        <div class="d-flex align-items-center gap-8 text-secondary-light">
                            <span class="">
                                Rows per page:
                            </span>
                            <div class="dt-length">
                                <select name="dataTable_length" aria-controls="dataTable"
                                    class="dt-input form-control form-select">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                        </div>
                    </div>
                <div class="p-0">
                    <table class="table data-table" id="" data-page-length='10'>       
                        <thead>
                            <tr>
                                <th scope="col">
                                    <div class="form-check style-check d-flex align-items-center">
                                        <!-- <input class="form-check-input" type="checkbox"> -->
                                        <label class="form-check-label">
                                            SN
                                        </label>
                                    </div>
                                </th>
                                <th scope="col">Course</th>
                                <th scope="col">Subject</th>
                                <th scope="col">Main Cat</th>
                                <th scope="col">Sub Cat</th>
                                <th scope="col">Duration</th>
                                <th scope="col">Language</th>
                                <th scope="col">Total Lesson</th>
                                <th scope="col">Price</th> 
                                <th scope="col">Status</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>

                            <% courses.forEach((course, index) => { %>
 
                            <tr>
                                <td>
                                    <div class="form-check style-check d-flex align-items-center"> 
                                        <label class="form-check-label">
                                            <%= index+1 %>
                                        </label>
                                    </div>
                                </td>
                                <td><span class="text-primary-600"><a href="/course/recorded-course/view/<%= course._id %>"><%= course.name ?? 'N/A' %></a></span></td>
                                <td><%= course.subject_id?.name ?? 'N/A' %></td>
                                <td><%= course.main_category_id?.name ?? 'N/A' %></td>
                                <td><%= course.sub_category_id?.name ?? 'N/A' %></td>
                                <td>
                                     <%= course.total_hrs ?? 'N/A'  %>:<%= course.total_min ?? 'N/A'  %> Hrs
                                </td>
                                <td><%= course.language ?? 'N/A' %></td>
                                <td><%= course.total_no_of_lesson ?? 'N/A' %></td>
                                <td>Rs. <%= course.sale_price ?? 'N/A' %>/-</td> 
                                <td> <span
                                        class="<%= course.status == true ? ' bg-success-100 text-success-600':' bg-danger-100 text-danger-600' %>  px-24 py-4 radius-4 fw-medium text-sm">Active</span>
                                </td>
                              <td class="text-center">
                                            <span class="d-flex">   
                                                <a href="/course/recorded-course/view/<%= course._id %>" title="View"
                                                    class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex justify-content-center gap-2 p-6">
                                                    <i class="ri-eye-line"></i> 
                                                </a> 
                                                <a href="/course/recorded-course/edit/<%= course._id %>" title="Edit"
                                                    class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex justify-content-center gap-2 p-6">
                                                    <i class="ri-edit-2-line"></i> 
                                                </a>
                                           </span>
                                          <span class="d-flex">   
                                                <a href="/course/recored-course-test/<%= course._id %>" title="Test"
                                                    class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex justify-content-cente gap-2 p-6">
                                                     <i class="ri-file-edit-line"></i> 
                                                </a> 
                                                 <button title="Delete"
                                                class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex justify-content-center gap-2 p-6 delete_btn"
                                                type="button" data-id="<%= course._id %>">
                                                <i class="ri-delete-bin-6-line"></i>
                                            </button>
                                           </span> 
                                </td>
                            </tr>  
                           <% }) %> 
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%
script = `
<script src="/assets/js/pages/recorded_course.js"></script>
`;
%>