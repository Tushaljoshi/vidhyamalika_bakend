
<div class="dashboard-main-body">

<div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
  <div class="">
    <h1 class="fw-semibold mb-4 h6 text-primary-light">Edit Course</h1>
    <div class="">
      <a href="/dashboard" class="text-secondary-light hover-text-primary hover-underline">Dashboard </a>
      <a href="/course/recorded-course" class="text-secondary-light hover-text-primary hover-underline "> / Live Course</a>
      <span class="text-secondary-light">/ Edit Course</span>
    </div>
  </div>    
</div>

<form class="mt-24" method="POST" action="/course/live-course/update" enctype="multipart/form-data">
    <input type="hidden" value="<%= course._id %>" name="course_id">
    <div class="row gy-3">
        <div class="col-lg-12">
            <div class="shadow-1 radius-12 bg-base h-100 overflow-hidden">
                <div
                    class="card-header border-bottom bg-base py-16 px-24 d-flex align-items-center justify-content-between">
                    <h6 class="text-lg fw-semibold mb-0">Course Detail</h6>
                </div>
                <div class="card-body p-20">
                    <div class="row gy-3">
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class="">
                                <label for="course_name" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Course Name <span class="text-danger-600">*</span> </label>
                                <input type="text" class="form-control" id="course_name" name="course_name" value="<%= course.name %>" placeholder="Enter Course Name" required>
                            </div>
                        </div>  
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class=""><label for="subject" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Subject<span class="text-danger-600">* </span> </label>
                                <select id="subject" class="form-control form-select" name="subject" required>
                                    <option value="">Select Subject</option>
                                  <% subjects.forEach((subject) => { %>
                                    <option value="<%= subject._id %>" <%= course.subject_id?.toString() === subject._id.toString() ? 'selected' : '' %> >
                                        <%= subject.name %>
                                    </option>  
                                <% }) %>
                                </select>
                            </div>
                        </div>
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class=""><label for="main_category" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Main Category<span class="text-danger-600">* </span> </label>
                                <select id="main_category" class="form-control form-select" name="main_category" required>
                                    <option value="" selected>Select Main Category</option> 
                                     <% main_categories.forEach((category) => { %>
                                    <option value="<%= category._id %>" <%= course.main_category_id?.toString() === category._id.toString() ? 'selected' : '' %> >
                                        <%= category.name %>
                                    </option>  
                                <% }) %>
                                </select>
                            </div>
                        </div>
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class=""><label for="sub_category" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Sub Category<span class="text-danger-600">* </span> </label>
                                <select id="sub_category" class="form-control form-select" name="sub_category" required>
                                    <option value="" selected>Select Sub Category</option> 
                                       <% sub_categories.forEach((category) => { %>
                                    <option value="<%= category._id %>" <%= course.sub_category_id?.toString() === category._id.toString() ? 'selected' : '' %> >
                                        <%= category.name %>
                                    </option>  
                                <% }) %>
                                </select>
                            </div>
                        </div>
                         
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class=""><label for="language" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Language<span class="text-danger-600">* </span> </label>
                                <select id="language" class="form-control form-select" name="language" value="<%= course.language %>" required>
                                    <option value="" disabled>Select Language</option>
                                    <option value="English" <%= course.language == "English" ? "selected":"" %> >English</option>
                                    <option value="Hindi" <%= course.language == "Hindi" ? "selected":"" %> >Hindi</option>
                                    <option value="Hinglish" <%= course.language == "Hinglish" ? "selected":"" %> >Hinglish</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class=""><label for="certificate" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Certificate<span class="text-danger-600">* </span> </label>
                                <select id="certificate" class="form-control form-select" name="certificate" required>
                                    <option value="" disabled>Select</option>
                                    <option value="Yes" <%= course.certificate == "Yes" ? "selected":"" %> >Yes</option>
                                    <option value="No" <%= course.certificate == "No" ? "selected":"" %> >No</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class=""><label for="no_of_lesson" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Total No. of Lesson <span class="text-danger-600">*</span> </label>
                                <input type="number" class="form-control" id="no_of_lesson" name="no_of_lesson" value="<%= course.total_no_of_lesson %>" min="1" placeholder="Enter Total No. of Lesson" required>
                            </div>
                        </div>
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class=""><label for="price" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Price<span class="text-danger-600">*</span> </label>
                                <input type="number" class="form-control" id="price" name="price" value="<%= course.price %>" min="1" placeholder="Price" required>
                            </div>
                        </div>
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class=""><label for="sale_price" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Sale Price<span class="text-danger-600">*</span> </label>
                                <input type="number" class="form-control" id="sale_price" name="sale_price" value="<%= course.sale_price %>" min="1" placeholder="Sale Price" required>
                            </div>
                        </div> 
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class=""><label for="thumbnail" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Thumbnail<span class="text-danger-600">*</span> </label>
                                <input type="file" class="form-control" id="thumbnail" name="thumbnail" accept=".png,.jpg,.jpeg,.webp">
                                <img src="<%= course.thumbnail %>" width="40%" class="mt-3">
                            </div>
                        </div> 
                        <div class="col-xxl-12 col-xl-12 col-sm-12">
                            <div class=""><label for="short_description" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Short Description<span class="text-danger-600">*</span> </label>
                            <textarea class="form-control text_editor" id="short_description" name="short_description" placeholder="Short Description" required><%= course.short_description ?? "" %></textarea>
                            </div>
                        </div> 
                        <div class="col-xxl-12 col-xl-12 col-sm-12">
                            <div class=""><label for="full_description" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Full Description<span class="text-danger-600">*</span> </label>
                            <textarea class="form-control text_editor" id="full_description" name="full_description" placeholder="Full Description" required><%= course.full_description ?? "" %></textarea>
                            </div>
                        </div>  
                        <div class="col-xxl-12 col-xl-12 col-sm-12">
                            <div class=""><label for="curriculum" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Curriculum</label>
                            <textarea class="form-control text_editor" id="curriculum" name="curriculum" placeholder="Curriculum" required><%= course.curriculum ?? "" %></textarea>
                            </div>
                        </div> 
                    </div>
                   <div class="col-12">
                    <div class="d-flex justify-content-end gap-3 mt-8"> 
                        <button type="submit" class="btn btn-primary-600 border border-primary-600 text-md px-28 py-12 radius-8">Update</button>
                    </div>
                </div> 
                </div>
            </div>
        </div> 
                
            </div>
        </form>
    </div>
<%
script = `
  <script src="/assets/js/pages/live_course.js"></script>
`;
%>