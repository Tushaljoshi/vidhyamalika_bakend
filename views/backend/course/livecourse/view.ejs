
<div class="dashboard-main-body">
<div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
  <div class="">
    <h1 class="fw-semibold mb-4 h6 text-primary-light">Course Detail</h1>
    <div class="">
      <a href="/dashboard" class="text-secondary-light hover-text-primary hover-underline">Dashboard </a>
      <a href="/course/recorded-course" class="text-secondary-light hover-text-primary hover-underline "> / Online Course</a>
      <span class="text-secondary-light">/ Course Detail</span>
    </div>
  </div> 
</div>

<form class="mt-24" method="POST" action="/course/recorded-course/update" enctype="multipart/form-data">
    <input type="hidden" value="<%= course._id %>" name="course_id">
    <div class="row gy-3">
        <div class="col-lg-12">
            <div class="shadow-1 radius-12 bg-base h-100 overflow-hidden">
                <div class="card-header border-bottom bg-base py-16 px-24 d-flex align-items-center justify-content-between">
                    <h6 class="text-lg fw-semibold mb-0">Course Detail</h6>
                    <a class="btn btn-primary" href="/course/live-course/edit/<%= course._id %>">Edit Course</a>
                </div>
                <div class="card-body p-20">
                    <div class="row gy-3">
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class="">
                                <label for="course_name" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Course Name </label>
                              <p><%= course.name %></p>
                            </div>
                        </div>  
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class="">
                                <label for="course_name" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Subject </label>
                              <p><%= course.subject_id?.name ?? "N/A" %></p>
                            </div>
                        </div>  
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class="">
                                <label for="course_name" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Main Category </label>
                              <p><%= course.main_category_id?.name ?? "N/A" %></p>
                            </div>
                        </div>  
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class="">
                                <label for="course_name" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Sub Category </label>
                              <p><%= course.sub_category_id?.name ?? "N/A" %></p>
                            </div>
                        </div>  
                         
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class="">
                                <label for="language" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Language </label>
                                <p><%= course.language %></p>
                               
                            </div>
                        </div>
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class="">
                                <label for="certificate" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Certificate </label>
                                <p><%= course.certificate %></p>
                            </div>
                        </div>
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class=""><label for="no_of_lesson" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Total No. of Lesson</label>
                                <p><%= course.total_no_of_lesson %></p>
                            </div>
                        </div>
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class="">
                                <label for="price" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Price</label>
                                <p><%= course.price %></p>
                            </div>
                        </div>
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class=""><label for="sale_price" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Sale Price</label>
                                <p><%= course.sale_price %></p>
                            </div>
                        </div> 
                        <div class="col-xxl-12 col-xl-12 col-sm-12">
                            <div class=""><label for="sale_price" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Sale Price</label>
                                <p><%- course.short_description ?? "" %></p>
                            </div>
                        </div> 
                        <div class="col-xxl-12 col-xl-12 col-sm-12">
                            <div class=""><label for="sale_price" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Sale Price</label>
                                <p><%- course.full_description ?? "" %></p>
                            </div>
                        </div> 
                        <div class="col-xxl-12 col-xl-12 col-sm-12">
                            <div class=""><label for="sale_price" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Sale Price</label>
                                <p><%- course.curriculum ?? "" %></p>
                            </div>
                        </div> 
                        <div class="col-xxl-6 col-xl-6 col-sm-6">
                            <div class="">
                                <label for="thumbnail" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Thumbnail</label><br>
                                <img src="<%= course.thumbnail %>" width="40%" name="thumbnail" class="mt-3">
                            </div>
                        </div> 
                    </div>
                </div>
            </div>
        </div>
          
    </div>
</form>
    </div>
<%
script = `
    <script src="/assets/js/pages/recorded_course.js"></script>
`;
%>