   <div class="dashboard-main-body">
        <div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
            <div class="">
                <h6 class="fw-semibold mb-4">Social Media Links</h6>
                <div class="">
                    <a href="/dashboard" class="text-secondary-light hover-text-primary hover-underline">Dashboard </a>

                    <span class="text-secondary-light">/ Social Media Links</span>
                </div>
            </div>
            <button type="button" class="add_new_btn btn btn-primary-600 d-flex align-items-center gap-6 ">
                <span class="d-flex text-md">
                    <i class="ri-add-large-line"></i>
                </span>
                  Add New
            </button>
        </div>
        <div class="mt-24">
            <div class="card h-100">
                <div class="card-body dataTable-wrapper p-0">
                    <div class="d-flex flex-wrap align-items-center gap-16 px-20 py-12 border-bottom border-neutral-200">
                        <form class="navbar-search dt-search m-0">
                            <input type="text" class="dt-input bg-transparent radius-4" aria-controls="dataTable"
                                name="search" placeholder="Search...">
                            <iconify-icon icon="ion:search-outline" class="icon"></iconify-icon>
                        </form>
                    </div>
                    <div class="p-0">
                        <table class="table data-table" id="dataTable" data-page-length='10'>
                            <thead>
                                <tr>
                                    <th scope="col">  
                                                SN 
                                    </th>
                                    <th scope="col">Title</th>
                                    <th scope="col">Icon</th>
                                    <th scope="col">Url</th>
                                    <th scope="col">Status</th>
                                    <th scope="col" class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            <% links.forEach((link, index) => { %>
                                <tr>
                                        <td> <%= index + 1 %> 
                                        </td>
                                        <td><span class=""><%= link.title %></span></td>
                                        <td><span class=""><%= link.icon %></span></td>
                                        <td><span class=""><%= link.url %></span></td>
                                      
                                        <td><span
                                                class="<%= link.status ? 'bg-success-100 text-success-600' : 'bg-danger-100 text-danger-600' %>  px-24 py-4 radius-4 fw-medium text-sm"><%= link.status ? "Active" : "Inactive" %></span>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex">
                                                <button
                                                title="Edit"
                                                    class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex justify-content-center gap-2 py-6 edit_btn"
                                                    type="button" data-id="<%= link._id %>" data-title="<%= link.title %>" data-url="<%= link.url %>" data-icon="<%= link.icon %>" data-status="<%= link.status == true ? 'active':'inactive' %>">
                                                    <i class="ri-edit-2-line"></i></button>
                                                <button
                                                title="Delete"
                                                    class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex justify-content-center gap-2 py-6 delete_btn"
                                                    type="button" data-id="<%= link._id %>">
                                                    <i class="ri-delete-bin-6-line"></i>
                                                </button> 
                                            </div>
                                        </td>
                                    </tr>
                          <%  }) %>

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- create sidebar -->
    <div
    class="create_form_sidebar bg-white position-fixed end-0 top-0 h-100vh overflow-y-auto z-99 max-w-700-px w-100 translate-x-full duration-300 active-translate-0">
    <div class="px-20 py-12 border-bottom d-flex align-items-center justify-content-between gap-20">
        <h5 class="text-lg mb-0">Add New</h5>
        <button type="button" class="close_sidebar_form text-danger-600 text-lg d-flex">
            <i class="ri-close-large-line"></i>
        </button>
    </div>
    <form action="/social-media-links/store" method="POST" class="d-flex flex-column gap-20 p-20">
        <div class="">
            <label for="title" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Title</label>
            <input type="text" class="form-control" name="title" id="title" placeholder="Enter Title" required>
        </div>
        <div class="">
            <label for="icon" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Icon</label>
            <input type="text" class="form-control" name="icon" id="icon" placeholder="Enter Icon Code" required>
        </div>
        <div class="">
            <label for="url" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Url</label>
            <input type="text" class="form-control" name="url" id="url" placeholder="Enter URL" required>
        </div> 
        <div class="">
            <label for="status" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Status</label>
            <select id="status" class="form-control form-select" name="status" required>
                <option value="Select a class" disabled>Select a Status</option>
               <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
        <div class="d-flex align-items-center justify-content-center gap-3 mt-8">
            <button type="reset"
                class="border border-danger-600 bg-hover-danger-200 text-danger-600 text-md px-50 py-11 radius-8">
                Reset
            </button>
            <button type="submit" class="btn btn-primary-600 text-md px-48 py-12 radius-8">
                Save
            </button>
        </div>
    </form>
</div>


<!-- edit sidebar -->
 <div
    class="edit_sidebar_form bg-white position-fixed end-0 top-0 h-100vh overflow-y-auto z-99 max-w-700-px w-100 translate-x-full duration-300 active-translate-0">
    <div class="px-20 py-12 border-bottom d-flex align-items-center justify-content-between gap-20">
        <h5 class="text-lg mb-0">Edit Link</h5>
        <button type="button" class="close_sidebar_form text-danger-600 text-lg d-flex">
            <i class="ri-close-large-line"></i>
        </button>
    </div>
    <form action="/social-media-links/update" method="POST" class="d-flex flex-column gap-20 p-20">
        <input type="hidden" name="link_id" id="link_id">
        <div class="">
            <label for="title" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Title</label>
            <input type="text" class="form-control" name="title" id="edit_title" placeholder="Enter Title" required>
        </div>
        <div class="">
            <label for="icon" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Icon</label>
            <input type="text" class="form-control" name="icon" id="edit_icon" placeholder="Enter Icon Code" required>
        </div>
        <div class="">
            <label for="url" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Url</label>
            <input type="text" class="form-control" name="url" id="edit_url" placeholder="Enter URL" required>
        </div> 
        <div class="">
            <label for="edit_link_status" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Status</label>
            <select id="edit_link_status" class="form-control form-select" name="edit_link_status">
                <option value="Select a class" disabled>Select a Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
        <div class="d-flex align-items-center justify-content-center gap-3 mt-8"> 
            <button type="submit" class="btn btn-primary-600 text-md px-48 py-12 radius-8">
                Save
            </button>
        </div>
    </form>
</div>

<%
script = `
<script src="/assets/js/pages/social_media_link.js"></script>
`;
%>