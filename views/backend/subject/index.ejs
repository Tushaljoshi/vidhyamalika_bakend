   <div class="dashboard-main-body">

        <div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
            <div class="">
                <h6 class="fw-semibold mb-4">All Subjects</h6>
                <div class="">
                    <a href="/dashboard" class="text-secondary-light hover-text-primary hover-underline">Dashboard </a>

                    <span class="text-secondary-light">/ All Subjects</span>
                </div>
            </div>
            <button type="button" class="my-sidebar-btn btn btn-primary-600 d-flex align-items-center gap-6 ">
                <span class="d-flex text-md">
                    <i class="ri-add-large-line"></i>
                </span>
                New Subject
            </button>
        </div>

        <div class="mt-24">
            <div class="card h-100">
                <div class="card-body dataTable-wrapper p-0">

                    <div class="d-flex flex-wrap justify-content-between gap-16 px-20 py-12 border-bottom border-neutral-200">
                        <form class="navbar-search dt-search m-0">
                            <input type="text" class="dt-input bg-transparent radius-4" aria-controls="dataTable"
                                name="search" placeholder="Search...">
                            <iconify-icon icon="ion:search-outline" class="icon"></iconify-icon>
                        </form>
                        <div class="d-flex align-items-center gap-8 text-secondary-light">
                            <span class="">
                                Rows per page:
                            </span>
                            <div class="dt-length">
                                <select name="dataTable_length" aria-controls="dataTable"
                                    class="dt-input form-control form-select">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="p-0">
                        <table class="table data-table" id="dataTable" data-page-length='10'>
                            <thead>
                                <tr>
                                    <th scope="col">SN</th>
                                    <th scope="col">Subject Name</th>
                                    <th scope="col">Image</th>
                                    <th scope="col">Status</th>
                                    <th scope="col" class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% subjects.forEach((subject, index) => { %>
                                    <tr>
                                        <td> <%= index + 1 %>  </td>
                                        <td><span class=""><%= subject.name %></span></td>
                                        <td><img src="<%= subject.image %>" width="50px"></td>
                                        <td><span
                                                class="<%= subject.status ? 'bg-success-100 text-success-600' : 'bg-danger-100 text-danger-600' %>  px-24 py-4 radius-4 fw-medium text-sm"><%= subject.status ? "Active" : "Inactive" %></span>
                                        </td>
                                        <td class="text-center">
                                            <span class="d-flex">
                                                <button
                                                    class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex align-items-center gap-2 py-6 justify-content-center edit_btn"
                                                     title="Edit"
                                                    type="button" data-id="<%= subject._id %>" data-name="<%= subject.name %>" data-status="<%= subject.status == true ? 'active':'inactive' %>">
                                                    <i class="ri-edit-2-line"></i></button>
                                                <button
                                                    class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex align-items-center gap-2 py-6 justify-content-center delete_btn"
                                                       title="Delete"
                                                    type="button" data-id="<%= subject._id %>">
                                                    <i class="ri-delete-bin-6-line"></i>
                                                </button>
                                            </span>   
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %> 

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- create sidebar -->
    <div
    class="my-sidebar bg-white position-fixed end-0 top-0 h-100vh overflow-y-auto z-99 max-w-700-px w-100 translate-x-full duration-300 active-translate-0">
    <div class="px-20 py-12 border-bottom d-flex align-items-center justify-content-between gap-20">
        <h5 class="text-lg mb-0">Add New Subject</h5>
        <button type="button" class="close-my-sidebar text-danger-600 text-lg d-flex">
            <i class="ri-close-large-line"></i>
        </button>
    </div>
    <form action="/subject/store" method="POST" class="d-flex flex-column gap-20 p-20" enctype="multipart/form-data">
        <div class="">
            <label for="subject_name" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Subject Name </label>
            <input type="text" class="form-control" name="name" id="subject_name" placeholder="Enter Subject Name" required>
        </div>
        <div class="">
            <label for="subject_image" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Upload Image </label>
            <input type="file" class="form-control" name="subject_image" id="subject_image">
        </div>
        <div class="">
            <label for="subject_status" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Status</label>
            <select id="subject_status" class="form-control form-select" name="status" required>
                <option value="Select a class" disabled>Select a Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
        <div class="d-flex align-items-center justify-content-center gap-3 mt-8">
            <button type="reset"
                class="border border-danger-600 bg-hover-danger-200 text-danger-600 text-md px-50 py-11 radius-8">
                Cancel
            </button>
            <button type="submit" class="btn btn-primary-600 text-md px-48 py-12 radius-8">
                Save
            </button>
        </div>
    </form>
</div>


<!-- edit sidebar -->
 <div
    class="edit-sidebar bg-white position-fixed end-0 top-0 h-100vh overflow-y-auto z-99 max-w-700-px w-100 translate-x-full duration-300 active-translate-0">
    <div class="px-20 py-12 border-bottom d-flex align-items-center justify-content-between gap-20">
        <h5 class="text-lg mb-0">Edit Subject</h5>
        <button type="button" class="close-my-sidebar text-danger-600 text-lg d-flex">
            <i class="ri-close-large-line"></i>
        </button>
    </div>
    <form action="/subject/update" method="POST" class="d-flex flex-column gap-20 p-20" enctype="multipart/form-data">
        <input type="text" name="subject_id" id="subject_id">
        <div class="">
            <label for="edit_subject_name" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Subject Name </label>
            <input type="text" class="form-control" name="name" id="edit_subject_name" placeholder="Enter Subject Name">
        </div>
         <div class="">
            <label for="subject_image" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Upload Image </label>
            <input type="file" class="form-control" name="subject_image" id="subject_image">
        </div>
        <div class="">
            <label for="edit_subject_status" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Status</label>
            <select id="edit_subject_status" class="form-control form-select" name="status">
                <option value="Select a class" disabled>Select a Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
        <div class="d-flex align-items-center justify-content-center gap-3 mt-8">
            <button type="reset"
                class="border border-danger-600 bg-hover-danger-200 text-danger-600 text-md px-50 py-11 radius-8">
                Cancel
            </button>
            <button type="submit" class="btn btn-primary-600 text-md px-48 py-12 radius-8">
                Save
            </button>
        </div>
    </form>
</div>

<%
script = `
<script src="/assets/js/pages/subject.js"></script>
`;
%>