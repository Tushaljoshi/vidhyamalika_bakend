
    <div class="dashboard-main-body">

        <div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
            <div class="">
                <h1 class="fw-semibold mb-4 h6 text-primary-light">Order Details</h1>
                <div class="">
                    <a href="/" class="text-secondary-light hover-text-primary hover-underline">Dashboard </a>
                    <a href="/orders" class="text-secondary-light hover-text-primary hover-underline"> /
                        Orders</a>
                    <span class="text-secondary-light">/ Order Details</span>
                </div>
            </div> 
        </div>
        <div class="mt-24">
            <div class="card h-100">
                <div class="card-body p-24">
                    <div class="d-flex gap-32 flex-md-row flex-column">
                        <div class="max-w-300-px w-100 text-center">
                            <figure class="mb-24 w-120-px h-120-px mx-auto rounded-circle overflow-hidden">
                                <img src="/assets/images/default_user.jpg" alt="Student Image" class="w-100 h-100 object-fit-cover">
                            </figure>
                            <h2 class="h6 text-primary-light mb-16 fw-semibold"><%= order.user_id?.name %></h2> 
                            <div class="mt-32 d-flex gap-16 w-100">
                                <% if(order.order_status == "completed"){ %>
                                    <button type="button"
                                        class="btn border fw-medium border-success-600 bg-hover-success-200 text-success-600 text-md d-flex justify-content-center align-items-center gap-8 flex-grow-1 px-12 py-8 radius-8"
                                        data-bs-toggle="modal" data-bs-target="#exampleModalDelete"> 
                                        <%= order.order_status.toUpperCase() %>
                                    </button>
                                <% }else{ %>
                                    <button type="button"
                                        class="btn border fw-medium border-danger-600 bg-hover-danger-200 text-danger-600 text-md d-flex justify-content-center align-items-center gap-8 flex-grow-1 px-12 py-8 radius-8"
                                        data-bs-toggle="modal" data-bs-target="#exampleModalDelete"> 
                                        <%= order.order_status.toUpperCase() %> 
                                    </button>
                                <% } %>

                                <% if(order.payment_status == "paid"){ %>
                                    <button type="button"
                                        class="btn border fw-medium border-success-600 bg-hover-success-200 text-success-600 text-md d-flex justify-content-center align-items-center gap-8 flex-grow-1 px-12 py-8 radius-8"
                                        data-bs-toggle="modal" data-bs-target="#exampleModalDelete"> 
                                        <%= order.payment_status.toUpperCase() %>
                                    </button>
                                <% }else{ %>
                                    <button type="button"
                                        class="btn border fw-medium border-danger-600 bg-hover-danger-200 text-danger-600 text-md d-flex justify-content-center align-items-center gap-8 flex-grow-1 px-12 py-8 radius-8"
                                        data-bs-toggle="modal" data-bs-target="#exampleModalDelete"> 
                                        <%= order.payment_status.toUpperCase() %> 
                                    </button>
                                <% } %>
                            </div>
                        </div>
                        <div class="">
                            <span class="h-100 w-1-px bg-neutral-200"></span>
                        </div>
                        <div class="flex-grow-1">
                            <div class="pb-16 border-bottom d-flex align-items-center justify-content-between gap-20">
                                <h3 class="h6 text-primary-light text-lg mb-0 fw-semibold">Student Detail</h3> 
                                <a class="btn btn-primary" href="/invoice/<%= order._id %>">Invoice</a>
                            </div>
                            <div class="mt-16 d-flex flex-column gap-8"> 
                                 <div class="d-flex gap-4">
                                    <span class="fw-semibold text-sm text-primary-light w-110-px">Email</span>
                                    <span class="fw-normal text-sm text-primary-600">: <%= order.user_id?.email ?? "N/A" %></span>
                                </div>
                                <div class="d-flex gap-4">
                                    <span class="fw-semibold text-sm text-primary-light w-110-px">Phone Number</span>
                                    <span class="fw-normal text-sm text-primary-600">: <%= order.user_id?.phone ?? "N/A" %></span>
                                </div>
                                <div class="d-flex gap-4">
                                    <span class="fw-semibold text-sm text-primary-light w-110-px">Gender</span>
                                    <span class="fw-normal text-sm text-secondary-light">: <%= order.user_id?.gender ?? "N/A" %></span>
                                </div> 
                                <div class="d-flex gap-4">
                                    <span class="fw-semibold text-sm text-primary-light w-110-px">Order Date</span>
                                    <span class="fw-normal text-sm text-secondary-light">: 
                                        <%= 
                                            new Date(order.createdAt).toLocaleDateString('en-IN', {
                                                day: '2-digit',
                                                month: 'short',
                                                year: 'numeric'
                                            })
                                        %>
                                    </span>
                                </div>
                                <div class="d-flex gap-4">
                                    <span class="fw-semibold text-sm text-primary-light w-110-px">Total Amount</span>
                                    <span class="fw-normal text-sm text-secondary-light">: ₹ <%= order.total_amount %>/-</span>
                                </div> 
                            </div>

                            <br>
                            <form method="POST" action="/order/update-order-status">
                                <input type="hidden" value="<%= order._id %>" name="order_id">
                            <div class="row"> 
                            <div class="col-xxl-5 col-xl-5 col-sm-5">
                                    <div class="">
                                        <label for="order_status"
                                            class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Order Status 
                                        <span class="text-danger-600">*</span> </label>
                                        <select id="order_status" name="order_status" class="form-control form-select">
                                            <option value="Select section" disabled>--Select--</option>
                                            <option value="pending" <%= order.order_status == "pending" ? "selected":"" %>>Pending</option>
                                            <option value="completed" <%= order.order_status == "completed" ? "selected":"" %>>Completed</option>
                                            <option value="cancelled" <%= order.order_status == "cancelled" ? "selected":"" %>>Cancelled</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xxl-5 col-xl-5 col-sm-5">
                                        <div class="">
                                            <label for="payment_status" class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Payment Status <span class="text-danger-600">*</span> </label>
                                            <select id="payment_status" name="payment_status" class="form-control form-select">
                                                <option value="Select section" disabled>--Select--</option>
                                                <option value="pending" <%= order.payment_status == "pending" ? "selected":"" %>>Pending</option>
                                                <option value="paid" <%= order.payment_status == "paid" ? "selected":"" %>>Paid</option>
                                                <option value="failed" <%= order.payment_status == "failed" ? "selected":"" %>>Failed</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xxl-2 col-xl-2 col-sm-2">
                                        <label for="payment_status" class="text-sm fw-semibold text-primary-light d-inline-block mb-8"> Action </label>
                                        <button class="btn btn-primary" type="submit">Update</button>
                                    </div>
                                </div>
                            </form>
                        </div> 
                        
                    </div>
                    
                </div>
            </div>
            <div class="my-16">
                <ul class="nav nav-pills bordered-tab mb-3" id="pills-tab" role="tablist"> 
                    <li class="nav-item" role="presentation">
                        <button
                            class="nav-link d-flex align-items-center gap-8 text-secondary-light fw-medium text-sm text-hover-primary-600 text-capitalize bg-transparent px-20 py-12 active"
                            id="pills-leave-tab" data-bs-toggle="pill" data-bs-target="#pills-leave" type="button"
                            role="tab" aria-controls="pills-leave" aria-selected="true">
                            <span class="d-flex tab-icon line-height-1 text-md">
                                    <i class="ri-login-box-line"></i>
                            </span>
                            Course Detail
                        </button>
                    </li> 
                </ul> 
                <div class="tab-content" id="pills-tabContent"> 
                    <div class="tab-pane fade show active" id="pills-leave" role="tabpanel" aria-labelledby="pills-leave-tab"
                        tabindex="0">
                        <div class="shadow-1 radius-12 bg-base h-100 overflow-hidden">

                            <div class="card shadow-sm border-0">
     

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Course Name</th>
                        <th>Course Type</th>
                        <th class="text-end">Price</th>
                    </tr>
                </thead>
                <tbody>
                    <% order.items.forEach((item, index)=>{ %>
                    <tr>
                        <td class="fw-semibold text-muted"><%= index + 1 %></td>

                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="icon-circle bg-light text-primary">
                                    <i class="ri-book-line"></i>
                                </div>
                                <span class="fw-medium">
                                    <% if(item.type == "recorded"){ %>
                                        <a href="/course/recorded-course/view/<%= item.course_id %>"><%= item.name ?? "N/A" %></a>
                                   <% }else{ %>
                                        <a href="/course/live-course/view/<%= item.course_id %>"><%= item.name ?? "N/A" %></a>
                                   <% } %>

                                </span>
                            </div>
                        </td>

                        <td>
                            <span class="badge bg-info text-dark text-uppercase">
                                <%= item.type ?? "N/A" %>
                            </span>
                        </td>

                        <td class="text-end fw-semibold text-secondary">
                            ₹ <%= item.price ?? "0" %>
                        </td>
                    </tr>
                    <% }) %>

                    <!-- Total Row -->
                    <tr class="table-light">
                        <td colspan="3" class="text-end fw-bold">Total Amount</td>
                        <td class="text-end fw-bold text-success">
                            ₹ <%= order.total_amount ?? "0" %>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%
script = `

`;
%>