
<div class="dashboard-main-body">
    <div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
    <div class="">
        <h1 class="fw-semibold mb-4 h6 text-primary-light">All Orders</h1>
        <div class="">
            <a href="/dashboard" class="text-secondary-light hover-text-primary hover-underline">Dashboard </a>
            <span class="text-secondary-light">/ All Orders</span>
        </div>
        </div>
        </div>
    <div class="mt-24">
        <div class="card h-100">
            <div class="card-body dataTable-wrapper p-0"> 
                <div class="d-flex flex-wrap justify-content-between gap-16 px-20 py-12 border-bottom border-neutral-200">
                        <form class="navbar-search dt-search m-0">
                            <input type="text" class="dt-input bg-transparent radius-4" aria-controls="dataTable"
                                name="search" placeholder="Search...">
                            <iconify-icon icon="ion:search-outline" class="icon"></iconify-icon>
                        </form>
                        <div class="d-flex align-items-center gap-8 text-secondary-light">
                            <span class="">
                                Rows per page:
                            </span>
                            <div class="dt-length">
                                <select name="dataTable_length" aria-controls="dataTable"
                                    class="dt-input form-control form-select">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                        </div>
                    </div>
                <div class="p-0">
                    <table class="table data-table" id="" data-page-length='10'>       
                        <thead>
                            <tr>
                                <th scope="col">
                                    <div class="form-check style-check d-flex align-items-center">
                                        <!-- <input class="form-check-input" type="checkbox"> -->
                                        <label class="form-check-label">
                                            S.L
                                        </label>
                                    </div>
                                </th>
                                <th scope="col">Order No.</th>
                                <th scope="col">Student</th>
                                <th scope="col">Total Amount</th>
                                <th scope="col">Order Status</th>
                                <th scope="col">Payment Status</th>
                                <th scope="col">Order Date</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>  
                            <% orders.forEach((order, index) => { %>
                            <tr>
                                <td>
                                    <div class="form-check style-check d-flex align-items-center"> 
                                        <label class="form-check-label"><%= index + 1 %></label>
                                    </div>
                                </td>
                                <td><span class="text-primary-600"><a href="/order/view/<%= order._id %>">#<%= order.order_number ?? "N/A" %></a></span></td>
                                <td><%= order.user_id?.name %></td>
                                <td>₹ <%= order.total_amount ?? "N/A" %>/-</td>
                               <td>
                                <% if(order.order_status == "completed"){ %>
                                    <span class=" bg-success-100 text-success-600 px-24 py-4 radius-4 fw-medium text-sm"><%= order.order_status.charAt(0).toUpperCase() + order.order_status.slice(1) %></span>
                                <% }else{ %>
                                    <span class=" bg-danger-100 text-danger-600 px-24 py-4 radius-4 fw-medium text-sm"><%= order.order_status.charAt(0).toUpperCase() + order.order_status.slice(1)  %></span>
                                <% } %>
                            </td>
                                <td>
                                    <% if(order.payment_status == "paid"){ %>
                                        <span class=" bg-success-100 text-success-600 px-24 py-4 radius-4 fw-medium text-sm"><%= order.payment_status.charAt(0).toUpperCase() + order.payment_status.slice(1) %></span>
                                    <% }else{ %>
                                        <span class=" bg-danger-100 text-danger-600 px-24 py-4 radius-4 fw-medium text-sm"><%= order.payment_status.charAt(0).toUpperCase() + order.payment_status.slice(1) %></span>
                                    <% } %>
                                </td>  
                                <td><%= new Date(order.createdAt).toLocaleDateString('en-IN', {
                                        day: '2-digit',
                                        month: 'short',
                                        year: 'numeric'
                                    }) %></td>
                                    <td>
                                        <div class="d-flex">
                                            <a href="/order/view/<%= order._id %>"
                                                title="View Order Detail"
                                                class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex justify-content-center gap-2 py-6">
                                               <i class="ri-eye-line"></i>
                                            </a> 
                                             <button
                                            class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex justify-content-center gap-2 py-6 delete_btn"
                                            title="Delete"
                                            type="button" data-id="<%= order._id %>">
                                            <i class="ri-delete-bin-6-line"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %> 
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%
script = `
<script src="/assets/js/pages/order.js"></script>
`;
%>